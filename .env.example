# Copy to .env and fill in to run locally:
#   DRY_RUN=1 PLAYLIST_URL="<apple music link>" node --env-file=.env update-playlist.mjs
# (Do NOT commit .env — it's gitignored.)

# Your omg.lol address (the part before .omg.lol). For samd.omg.lol this is "samd".
OMGLOL_ADDRESS=samd

# omg.lol API key — https://home.omg.lol/account (Account → API key)
OMGLOL_API_KEY=

# Timezone used to work out "this month". Optional; UTC default.
PLAYLIST_TZ=America/Chicago

# Usually passed on the command line instead:
# PLAYLIST_URL=      Apple Music share link (••• → Share → Copy Link)
# PLAYLIST_MONTH=    month it's for, like 2026-10 (default: this month)
# DRY_RUN=1          print what would change, publish nothing
